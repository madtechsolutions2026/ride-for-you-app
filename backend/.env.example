# Postgres connection string.
#   local : postgresql://postgres:<PASSWORD>@localhost:5432/rideforyou?schema=public
#   Render: copy the "Internal Database URL" from your Render Postgres instance
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

PORT=3000

# Use a long random value in production — never the default below.
JWT_SECRET="change-me"

# ---- Cloudflare R2: private bucket (KYC documents, presigned reads) ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ---- Cloudflare R2: public bucket (catalogue assets — bike images) ----
# R2_PUBLIC_BASE_URL is the public/CDN origin; bike imageUrl = base + "/" + imageKey.
R2_PUBLIC_BUCKET=""
R2_PUBLIC_BASE_URL=""
