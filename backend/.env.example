# Postgres connection string.
#   local : postgresql://postgres:<PASSWORD>@localhost:5432/rideforyou?schema=public
#   Render: copy the "Internal Database URL" from your Render Postgres instance
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

PORT=3000

# Use a long random value in production — never the default below.
JWT_SECRET="change-me"

# ---- Cloudflare R2: private bucket (KYC documents, presigned reads) ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ---- Cloudflare R2: public bucket (catalogue assets — bike images) ----
# R2_PUBLIC_BASE_URL is the public/CDN origin; bike imageUrl = base + "/" + imageKey.
R2_PUBLIC_BUCKET=""
R2_PUBLIC_BASE_URL=""

# ---- Collections: UPI QR for weekly rent ----
# The company VPA riders pay into. Without it the midnight notice still goes
# out and in-app payment still works, but no QR is generated (the app hides
# the QR block rather than showing an empty square).
UPI_VPA=""
UPI_PAYEE_NAME="Ride For You"

# Public origin of this server, used for PhonePe redirect/callback URLs.
PUBLIC_BASE_URL=""
# Scheme behind the deep link in rent notifications: <scheme>://rental?payInvoiceId=...
APP_DEEP_LINK_SCHEME="rideforyou"

# ---- Payment gateways ----
# `stub` writes real ledger rows without calling a gateway. Set to `live` only
# once the credentials below are filled in.
PAYMENTS_MODE="stub"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX="1"
