datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String      @id
  phone           String      @unique
  fullName        String?
  email           String?
  city            String?
  avatarUrl       String?
  role            String      @default("RIDER") // RIDER, DRIVER, ADMIN
  accountStatus   String      @default("ACTIVE") // ACTIVE, SUSPENDED

  // Cached KYC summary. Source of truth is the latest KycVerification row.
  kycStatus       String      @default("PENDING") // PENDING, SUBMITTED, APPROVED, REJECTED

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sessions         Session[]
  kycVerifications KycVerification[]
}

model OtpChallenge {
  id                String   @id
  phone             String
  code              String
  expiresAt         DateTime
  resendAvailableAt DateTime
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  revoked      Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// One row per KYC submission attempt. Re-submissions (after a rejection) create a
// new row so the full history is retained. User.kycStatus mirrors the latest row.
model KycVerification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status String @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED

  // Applicant-entered details
  fullName      String?
  dateOfBirth   DateTime?
  address       String?
  aadhaarNumber String?
  panNumber     String?

  // R2 object keys. The bucket is private; API responses return short-lived
  // presigned GET URLs derived from these keys, never the keys themselves.
  aadhaarFrontKey String?
  aadhaarBackKey  String?
  panCardKey      String?
  selfieKey       String?
  addressProofKey String?

  // Admin review
  reviewedBy   String? // admin User.id
  reviewedAt   DateTime?
  rejectReason String?

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
