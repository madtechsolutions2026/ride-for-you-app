datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String  @id
  phone         String  @unique
  fullName      String?
  email         String?
  city          String?
  avatarUrl     String?
  // RIDER · ADMIN · EXECUTIVE (hub handover/return/damage) · SUPPORT (payments/queries)
  role          String  @default("RIDER")
  accountStatus String  @default("ACTIVE") // ACTIVE, SUSPENDED

  // --- Staff-only (null for riders) ---
  // Which hub an EXECUTIVE is posted to. Their queues are scoped to it.
  assignedHubId String?
  assignedHub   Hub?     @relation("HubStaff", fields: [assignedHubId], references: [id], onDelete: SetNull)
  // Extra screen grants on top of the role's defaults, e.g. ["finance","fleet"].
  permissions   String[] @default([])
  invitedById   String?
  invitedBy     User?    @relation("StaffInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  staffInvites  User[]   @relation("StaffInvites")

  // Cached KYC summary. Source of truth is the latest KycVerification row.
  kycStatus String @default("PENDING") // PENDING, SUBMITTED, APPROVED, REJECTED

  // --- Collections history ---
  //
  // A bike recovered for non-payment is the single most useful thing to know
  // about a rider at their next booking, so it is denormalised onto the
  // profile rather than left to be re-derived from RecoveryJob every time.
  // RecoveryJob remains the detailed record; these are the summary.
  recoveryCount  Int       @default(0)
  lastRecoveryAt DateTime?
  /// Weeks of rent written off across all recoveries, in rupees.
  writtenOffAmount Int @default(0)

  // Expo push token, registered by the app after login. Null until the
  // rider grants notification permission (or on a build without the module).
  pushToken          String?
  pushTokenUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions         Session[]
  kycVerifications KycVerification[]

  bookings        Booking[]
  rentals         Rental[]       @relation("RentalRider")
  handoversGiven  Rental[]       @relation("RentalHandoverBy")
  returnsReceived Rental[]       @relation("RentalReturnBy")
  payments        Payment[]
  damageReports   DamageReport[] @relation("DamageReporter")
  recoveryJobs    RecoveryJob[]  @relation("RecoveryAssignee")
  deploymentLogs  BikeDeploymentLog[]
  supportTickets  SupportTicket[]

  wallet            Wallet?
  walletCreditsIssued WalletTransaction[] @relation("WalletCreditIssuer")
  notifications     Notification[]
  supportMessages   SupportMessage[]  @relation("SupportMessageAuthor")
  batterySwaps      BatterySwap[]     @relation("BatterySwapRider")
  rentalRequests    RentalRequest[]   @relation("RentalRequestRider")
  rentalRequestsDecided RentalRequest[] @relation("RentalRequestDecider")

  @@index([role])
  @@index([assignedHubId])
}

model OtpChallenge {
  id                String   @id
  phone             String
  code              String
  expiresAt         DateTime
  resendAvailableAt DateTime
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  revoked      Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// One row per KYC submission attempt. Re-submissions (after a rejection) create a
// new row so the full history is retained. User.kycStatus mirrors the latest row.
model KycVerification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status String @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED

  // Applicant-entered details
  fullName      String?
  dateOfBirth   DateTime?
  address       String?
  aadhaarNumber String?
  panNumber     String?

  // R2 object keys. The bucket is private; API responses return short-lived
  // presigned GET URLs derived from these keys, never the keys themselves.
  aadhaarFrontKey String?
  aadhaarBackKey  String?
  panCardKey      String?
  selfieKey       String?
  addressProofKey String?

  // Admin review
  reviewedBy   String? // admin User.id
  reviewedAt   DateTime?
  rejectReason String?

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Rental discovery (slice: map + bike views)
//
// Read-only for riders. There is ONE rental Hub where every bike is picked up
// and returned; SwapStation rows are just extra map pins where a SWAP rider
// swaps a drained battery mid-rental. Riders browse by BikeModel (the
// catalogue); a physical Bike unit is only assigned later, at handover.
// No User relation in this slice — "who booked what" arrives with Booking.
// ---------------------------------------------------------------------------

model Hub {
  id           String   @id @default(uuid())
  name         String
  address      String
  lat          Float
  lng          Float
  city         String?
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  openTime     String? // "09:00" (Asia/Kolkata)
  closeTime    String? // "20:00"
  contactPhone String?

  managerId    String?
  manager      Employee? @relation("HubManager", fields: [managerId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bikes          Bike[]
  bookings       Booking[]
  rentals        Rental[]
  staff          User[]              @relation("HubStaff")
  employees      Employee[]          @relation("HubEmployees")
  deploymentLogs BikeDeploymentLog[]
  expenses       Expense[]
  servicePersons ServicePerson[]
  batterySwaps   BatterySwap[]
  rentalRequests RentalRequest[]

  @@index([status])
}

model SwapStation {
  id        String   @id @default(uuid())
  name      String
  address   String
  lat       Float
  lng       Float
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  openTime  String?
  closeTime String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batterySwaps BatterySwap[]

  @@index([status])
}

// The catalogue. One row per model, shared by every physical unit of it.
model BikeModel {
  id              String   @id @default(uuid())
  name            String
  category        String // SWAP, HOME
  topSpeedKmph    Int
  rangeKm         Int // rated range on a full charge
  requiresLicense Boolean  @default(false)
  chargerIncluded Boolean  @default(false)
  imageKey        String? // private R2 object key; responses return a presigned URL
  status          String   @default("ACTIVE") // ACTIVE = visible to riders, INACTIVE = hidden
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bikes    Bike[]
  plans    RentalPlan[]
  bookings Booking[]

  @@index([category])
  @@index([status])
}

// A physical bike in the fleet.
model Bike {
  id                 String    @id @default(uuid())
  modelId            String
  model              BikeModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  hubId              String
  hub                Hub       @relation(fields: [hubId], references: [id], onDelete: Cascade)
  registrationNumber String    @unique
  colour             String?
  batteryPercent     Int       @default(100)
  odometerKm         Int       @default(0)
  status             String    @default("AVAILABLE") // AVAILABLE, RESERVED, RENTED, MAINTENANCE

  // Last known position (updated by the IoT tracker; null until first ping).
  lastLat    Float?
  lastLng    Float?
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentals        Rental[]
  damageReports  DamageReport[]
  recoveryJobs   RecoveryJob[]
  reservations   Booking[]           @relation("BikeReservation")
  deploymentLogs BikeDeploymentLog[]
  serviceTickets ServiceTicket[]
  batterySwaps   BatterySwap[]

  @@index([modelId])
  @@index([hubId])
  @@index([status])
}

// Pricing tiers for a model. One row per (model, duration).
model RentalPlan {
  id        String    @id @default(uuid())
  modelId   String
  model     BikeModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  duration  String // DAY, WEEK, MONTH
  price     Int // integer rupees
  deposit   Int       @default(0)
  kmLimit   Int? // null = unlimited
  status    String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings Booking[]

  @@unique([modelId, duration])
  @@index([modelId])
}

// ===========================================================================
// V1 operational layer — bookings, rentals, payments, weekly billing,
// damage, roadside/police recovery. Riders create Bookings from the app;
// staff run everything else from the admin dashboard.
// ===========================================================================

// A rider's commitment to rent one BikeModel on one RentalPlan, picked up at
// the Hub. A physical Bike is only attached at handover (-> Rental).
model Booking {
  id        String @id @default(uuid())
  reference String @unique // human code e.g. RFY-8H2K9

  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId String
  model   BikeModel  @relation(fields: [modelId], references: [id], onDelete: Restrict)
  planId  String
  plan    RentalPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  hubId   String
  hub     Hub        @relation(fields: [hubId], references: [id], onDelete: Restrict)

  // PENDING (awaiting payment) · CONFIRMED (paid) · READY (bike allocated) ·
  // HANDED_OVER · CANCELLED · EXPIRED
  status String @default("PENDING")

  // Price snapshot (rupees) taken at booking time so later plan edits don't move it.
  rentAmount    Int
  depositAmount Int @default(0)
  platformFee   Int @default(0)
  totalAmount   Int

  // Insurance / nominee captured in the app before payment.
  nomineeName     String?
  nomineeRelation String?
  nomineePhone    String?
  insuranceRef    String?

  // Consent: T&C accepted with a drawn signature (R2 key) + language.
  consentAcceptedAt   DateTime?
  consentLanguage     String? // EN, HI, TE
  consentSignatureKey String?

  startsAt     DateTime? // planned handover
  // A PENDING booking holds its unit until this moment, then a sweep
  // expires it and puts the bike back on the shelf.
  expiresAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  // The specific unit held for this booking. Set at booking, cleared on
  // expiry/cancel, and becomes the Rental's bike at handover.
  // Uniqueness is NOT a DB constraint here: a plain `prisma db push` (what
  // Render runs on deploy) refuses to add one. The real guarantee is an
  // atomic Bike.status flip from AVAILABLE -> RESERVED, which only one
  // concurrent booking can win.
  reservedBikeId String?
  reservedBike   Bike?   @relation("BikeReservation", fields: [reservedBikeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments       Payment[]
  rental         Rental?
  deploymentLogs BikeDeploymentLog[]
  supportTickets SupportTicket[]

  @@index([userId])
  @@index([status])
  @@index([hubId])
}

// The active-rental lifecycle. Exactly one per Booking, created at handover.
model Rental {
  id        String  @id @default(uuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("RentalRider", fields: [userId], references: [id], onDelete: Cascade)
  bikeId String
  bike   Bike   @relation(fields: [bikeId], references: [id], onDelete: Restrict)
  hubId  String
  hub    Hub    @relation(fields: [hubId], references: [id], onDelete: Restrict)

  // ACTIVE · OVERDUE · RETURNED (bike back, closing) · COMPLETED · RECOVERED
  status String @default("ACTIVE")

  handoverById  String?
  handoverBy    User?    @relation("RentalHandoverBy", fields: [handoverById], references: [id], onDelete: SetNull)
  handoverAt    DateTime @default(now())
  odometerStart Int      @default(0)

  expectedReturnAt DateTime
  returnedAt       DateTime?
  returnById       String?
  returnBy         User?     @relation("RentalReturnBy", fields: [returnById], references: [id], onDelete: SetNull)
  odometerEnd      Int?

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  weeklyInvoices WeeklyInvoice[]
  damageReports  DamageReport[]
  recoveryJobs   RecoveryJob[]
  batterySwaps   BatterySwap[]
  requests       RentalRequest[]

  @@index([userId])
  @@index([status])
  @@index([bikeId])
}

// Every money movement. Riders pay from the app; staff can record MANUAL/CASH
// and mark refunds. Gateway webhooks flip status to SUCCESS/FAILED.
model Payment {
  id String @id @default(uuid())

  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId       String?
  booking         Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  weeklyInvoiceId String?
  weeklyInvoice   WeeklyInvoice? @relation(fields: [weeklyInvoiceId], references: [id], onDelete: SetNull)

  // RENT · DEPOSIT · PLATFORM_FEE · WEEKLY_RENT · LATE_FEE · DAMAGE · REFUND
  purpose  String
  amount   Int // rupees; negative for REFUND
  currency String @default("INR")

  // PHONEPE · RAZORPAY · CASHFREE · CASH · UPI_MANUAL · ADJUSTMENT
  provider          String
  providerOrderId   String?
  providerPaymentId String?
  // INITIATED · SUCCESS · FAILED · REFUNDED
  status            String  @default("INITIATED")

  rawWebhook   Json?
  note         String?
  recordedById String? // staff User.id when entered manually

  walletTransactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([bookingId])
  @@index([purpose])
}

// The recurring weekly rent for a live rental — the core of the old
// billing dashboard. A cron job generates one row per rental per week.
model WeeklyInvoice {
  id       String @id @default(uuid())
  rentalId String
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  weekNumber  Int // 1-based, since rental start
  periodStart DateTime
  periodEnd   DateTime
  amount      Int // rupees

  // PENDING · PAID · OVERDUE · WAIVED
  status String    @default("PENDING")
  dueAt  DateTime
  paidAt DateTime?

  reminderCount  Int       @default(0)
  lastReminderAt DateTime?
  paymentLinkUrl String?

  // --- Collections ladder ---
  //
  // dueAt ──2 days──> graceEndsAt ──> recovery
  //
  // The rider is chased every 2 hours inside that window, warned once on the
  // final day, and the bike is queued for recovery when the window closes.
  // Times are absolute so a sweep that misses a tick (restart, outage) still
  // escalates to the right stage rather than restarting the ladder.

  /// dueAt + the grace period. Past this and unpaid, the bike is recovered.
  graceEndsAt DateTime?
  /// Set once, when the "bike will be collected tomorrow" notice goes out.
  finalWarningAt DateTime?
  /// The midnight notice carrying the QR — set so it is never sent twice.
  billedNoticeAt DateTime?

  /// UPI deep link for this week's rent. Regenerated if the amount changes.
  upiUri String?

  /// NON_PAYMENT jobs raised for this week. The sweep only ever raises one -
  /// it checks for an open job first - but the relation stays many-to-one so
  /// no unique constraint is needed, which a plain db push would refuse.
  recoveryJobs RecoveryJob[] @relation("InvoiceRecovery")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments           Payment[]
  walletTransactions WalletTransaction[]

  @@unique([rentalId, weekNumber])
  @@index([status])
  @@index([dueAt])
}

// Damage logged by an EXECUTIVE at return (or mid-rental). May become a charge.
model DamageReport {
  id       String @id @default(uuid())
  rentalId String
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  bikeId   String
  bike     Bike   @relation(fields: [bikeId], references: [id], onDelete: Restrict)

  reportedById String?
  reportedBy   User?   @relation("DamageReporter", fields: [reportedById], references: [id], onDelete: SetNull)

  // MINOR · MODERATE · MAJOR · TOTAL_LOSS
  severity    String
  description String
  photoKeys   String[] @default([]) // private R2 keys

  estimatedCost Int    @default(0)
  // PENDING · CHARGED · WAIVED · DISPUTED
  chargeStatus  String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rentalId])
  @@index([chargeStatus])
}

// Roadside assistance, accident, theft or police-hold recovery.
model RecoveryJob {
  id        String @id @default(uuid())
  reference String @unique // REC-2049

  // Set when collections raised this job automatically for unpaid rent.
  // Recovering a bike over money is a different conversation from recovering
  // one after a crash, and the desk needs to see which it is.
  weeklyInvoiceId String?
  weeklyInvoice   WeeklyInvoice? @relation("InvoiceRecovery", fields: [weeklyInvoiceId], references: [id], onDelete: SetNull)

  rentalId String?
  rental   Rental? @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  bikeId   String?
  bike     Bike?   @relation(fields: [bikeId], references: [id], onDelete: SetNull)

  // ROADSIDE · ACCIDENT · THEFT · POLICE_HOLD · BREAKDOWN · NON_PAYMENT
  type     String
  // OPEN · DISPATCHED · IN_PROGRESS · RESOLVED · CLOSED
  status   String @default("OPEN")
  priority String @default("NORMAL") // LOW · NORMAL · HIGH · CRITICAL

  reportedByPhone String?
  locationText    String?
  lat             Float?
  lng             Float?
  description     String

  assignedToId String?
  assignedTo   User?   @relation("RecoveryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  vanLabel     String?

  // Police-specific
  policeStation String?
  firNumber     String?

  dispatchedAt   DateTime?
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([weeklyInvoiceId])
}

// ===========================================================================
// Phase 2 Enterprise Operations:
// Hierarchy, Deployment Audit, Attendance, Payroll, Finance, Service & Support
// ===========================================================================

model Employee {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?
  role      String   @default("STAFF") // HUB_MANAGER, STAFF, SERVICE_PERSON
  hubId     String?
  hub       Hub?     @relation("HubEmployees", fields: [hubId], references: [id], onDelete: SetNull)
  joinDate  DateTime @default(now())
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managedHubs    Hub[]               @relation("HubManager")
  deploymentLogs BikeDeploymentLog[]
  attendances    Attendance[]
  salaries       Salary[]
  expensesAdded  Expense[]

  @@index([role])
  @@index([hubId])
  @@index([status])
}

model BikeDeploymentLog {
  id                     String    @id @default(uuid())
  bikeId                 String
  bike                   Bike      @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  hubId                  String
  hub                    Hub       @relation(fields: [hubId], references: [id], onDelete: Cascade)
  deployedByEmployeeId   String?
  deployedByEmployee     Employee? @relation(fields: [deployedByEmployeeId], references: [id], onDelete: SetNull)
  riderId                String
  rider                  User      @relation(fields: [riderId], references: [id], onDelete: Cascade)
  bookingId              String?
  booking                Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  deployedAt             DateTime  @default(now())
  returnedAt             DateTime?
  conditionNotesOnDeploy String?
  conditionNotesOnReturn String?
  odometerStart          Int?
  odometerEnd            Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([bikeId])
  @@index([hubId])
  @@index([riderId])
  @@index([deployedByEmployeeId])
}

model Attendance {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime
  checkInTime  DateTime?
  checkOutTime DateTime?
  status       String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LEAVE
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model Salary {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      Int       // 1-12
  year       Int       // e.g. 2026
  baseSalary Int
  deductions Int       @default(0)
  bonuses    Int       @default(0)
  netPaid    Int
  paidOn     DateTime?
  status     String    @default("PENDING") // PENDING, PAID
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([status])
}

model Expense {
  id                String    @id @default(uuid())
  hubId             String?
  hub               Hub?      @relation(fields: [hubId], references: [id], onDelete: SetNull)
  category          String    // RENT, SALARY, SERVICE, MISC
  amount            Int
  date              DateTime  @default(now())
  note              String?
  addedByEmployeeId String?
  addedByEmployee   Employee? @relation(fields: [addedByEmployeeId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([hubId])
  @@index([category])
  @@index([date])
}

model ServicePerson {
  id             String   @id @default(uuid())
  name           String
  phone          String   @unique
  specialization String?  // e.g. "Battery & Motor", "Brakes & Body", "General"
  status         String   @default("AVAILABLE") // AVAILABLE, BUSY, INACTIVE
  hubId          String?
  hub            Hub?     @relation(fields: [hubId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tickets ServiceTicket[]

  @@index([status])
  @@index([hubId])
}

model ServiceTicket {
  id                      String         @id @default(uuid())
  bikeId                  String
  bike                    Bike           @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  reportedIssue           String
  assignedServicePersonId String?
  assignedServicePerson   ServicePerson? @relation(fields: [assignedServicePersonId], references: [id], onDelete: SetNull)
  assignedAt              DateTime       @default(now())
  scheduledTime           DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  totalTimeTakenMinutes   Int?
  status                  String         @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, COMPLETED, CANCELLED
  totalCost               Int            @default(0)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  parts ServicePart[]
  notes ServiceNote[]

  @@index([bikeId])
  @@index([status])
  @@index([assignedServicePersonId])
}

model ServicePart {
  id              String        @id @default(uuid())
  serviceTicketId String
  serviceTicket   ServiceTicket @relation(fields: [serviceTicketId], references: [id], onDelete: Cascade)
  partName        String
  cost            Int
  quantity        Int           @default(1)
  createdAt       DateTime      @default(now())

  @@index([serviceTicketId])
}

model ServiceNote {
  id              String        @id @default(uuid())
  serviceTicketId String
  serviceTicket   ServiceTicket @relation(fields: [serviceTicketId], references: [id], onDelete: Cascade)
  note            String
  addedAt         DateTime      @default(now())

  @@index([serviceTicketId])
}

model SupportTicket {
  id            String    @id @default(uuid())
  ticketNumber  String    @unique // e.g. TKT-1042
  riderId       String
  rider         User      @relation(fields: [riderId], references: [id], onDelete: Cascade)
  bookingId     String?
  booking       Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  category      String    // BIKE_ISSUE, PAYMENT, BOOKING, OTHER
  subject       String?
  description   String
  attachmentUrl String?
  status        String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  adminNotes    String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages SupportMessage[]

  @@index([riderId])
  @@index([status])
  @@index([category])
}


// ---------------------------------------------------------------------------
// Rider wallet — company-issued credit only.
//
// Riders CANNOT top this up; there is no inbound payment path into it. The only
// things that create credit are money the company owes back (a refund, a
// reversed damage charge, a returned deposit) or credit the company grants
// (promo, goodwill). Credit is spent automatically against the next weekly
// invoice, so the balance can never go negative and never needs a gateway.
//
// The wallet is a cache of its own ledger: every mutation writes a
// WalletTransaction carrying the resulting balance, so the balance is always
// reconstructable and `balance` is only ever changed inside the same
// transaction that appends the row.
// ---------------------------------------------------------------------------

model Wallet {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Rupees. Never negative — spending is capped at the available balance.
  balance Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  // Denormalised so a rider's ledger reads without joining through Wallet.
  userId   String

  // CREDIT (money in) · DEBIT (money spent)
  direction String

  // CREDIT: REFUND · DAMAGE_REVERSAL · DEPOSIT_RETURN · PROMO · GOODWILL
  // DEBIT:  INVOICE_APPLIED · ADJUSTMENT
  reason String

  // Always positive; `direction` carries the sign.
  amount       Int
  // Wallet balance immediately after this row was applied.
  balanceAfter Int

  weeklyInvoiceId String?
  weeklyInvoice   WeeklyInvoice? @relation(fields: [weeklyInvoiceId], references: [id], onDelete: SetNull)
  paymentId       String?
  payment         Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  note         String?
  // Staff User.id when a human granted or adjusted the credit.
  issuedById   String?
  issuedBy     User?   @relation("WalletCreditIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([userId])
  @@index([reason])
}

// ---------------------------------------------------------------------------
// In-app notification inbox. Distinct from push: push is the delivery attempt
// (best-effort, may be denied or undelivered), this is the durable record the
// rider can always open. Everything that pushes also writes one of these.
// ---------------------------------------------------------------------------

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // BOOKING · PAYMENT · KYC · SUPPORT · RENTAL · SWAP · PROMO · SYSTEM
  category String
  title    String
  body     String

  // Deep link target, mirroring the push payload the app already understands.
  screen String?
  params Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Support ticket conversation. The original ticket description stays on
// SupportTicket; every reply after it — from either side — is a message here.
// ---------------------------------------------------------------------------

model SupportMessage {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // RIDER · AGENT
  authorType String
  // User.id of the rider or the staff member who wrote it.
  authorId   String?
  author     User?   @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  body String
  // Private R2 key; served to the client as a short-lived presigned URL.
  attachmentKey String?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// ---------------------------------------------------------------------------
// Battery swap events, logged when a rider scans a dock QR mid-rental.
// ---------------------------------------------------------------------------

model BatterySwap {
  id        String @id @default(uuid())
  reference String @unique // SWP-4T9K2

  rentalId String
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("BatterySwapRider", fields: [userId], references: [id], onDelete: Cascade)
  bikeId   String
  bike     Bike   @relation(fields: [bikeId], references: [id], onDelete: Restrict)

  stationId String?
  station   SwapStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  hubId     String?
  hub       Hub?         @relation(fields: [hubId], references: [id], onDelete: SetNull)

  // The code physically printed on the dock, as scanned.
  scannedCode String

  batteryOutPercent Int // what the rider handed in
  batteryInPercent  Int // what they took away

  createdAt DateTime @default(now())

  @@index([rentalId])
  @@index([userId])
  @@index([stationId])
}

// ---------------------------------------------------------------------------
// Rider-initiated changes to a live rental: extend it, or book a return slot.
// Staff approve or reject; approval is what actually moves the rental dates.
// ---------------------------------------------------------------------------

model RentalRequest {
  id        String @id @default(uuid())
  reference String @unique // REQ-7K3M1

  rentalId String
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("RentalRequestRider", fields: [userId], references: [id], onDelete: Cascade)

  // EXTENSION · RETURN
  type String

  // EXTENSION only — how many extra weeks, and the rent that implies.
  extraWeeks    Int?
  quotedAmount  Int?

  // RETURN only — when the rider wants to hand the bike back, and where.
  preferredSlotAt DateTime?
  hubId           String?
  hub             Hub?      @relation(fields: [hubId], references: [id], onDelete: SetNull)

  riderNote String?

  // PENDING · APPROVED · REJECTED · CANCELLED · COMPLETED
  status       String    @default("PENDING")
  decidedById  String?
  decidedBy    User?     @relation("RentalRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rentalId])
  @@index([userId])
  @@index([status])
  @@index([type])
}
