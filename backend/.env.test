# Test environment — used by Jest (see jest.config.js -> test/setup/env.ts).
# Points Prisma at a throwaway database that the suite truncates between tests.
# Create it once with:
#   psql -h localhost -p 5433 -U rideforyou -d rideforyou -c "CREATE DATABASE rideforyou_test"
DATABASE_URL="postgresql://rideforyou:rideforyou@localhost:5433/rideforyou_test?schema=public"
JWT_SECRET="test-secret-key"
NODE_ENV="test"

# R2 deliberately left unconfigured: presignGet() returns null and the KYC
# upload endpoint runs in "test mode" without touching Cloudflare.
